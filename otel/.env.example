# Local collector -> remote MLflow export configuration.
# Copy to otel/.env (gitignored) and fill in real values.

# Base64 of "<MLFLOW_USER>:<MLFLOW_PASS>" (no trailing newline):
#   printf '%s:%s' "$USER" "$PASS" | base64 -w0
# Sent as `Authorization: Basic ...` on every OTLP export.
MLFLOW_BASIC_B64=REPLACE-WITH-BASE64-USER-COLON-PASS

# The agent supplies the destination experiment ID for each request. No
# static trace experiment is required by the collector.
