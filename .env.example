# Shlepa environment configuration.
# Copy to .env and fill in real values. .env is gitignored.

# --- Main LLM endpoint (experiments / dev runs) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
LOCAL_AGENT_MODEL=

# --- Secondary (weaker) endpoint for CI ---
CI_OPENAI_BASE_URL=
CI_OPENAI_API_KEY=
CI_MODEL=

# --- MLflow tracking ---
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Telemetry (dev only; always stripped from the submission zip) ---
# 1 enables OpenTelemetry span export, empty/0 disables it
SLEPA_OTEL_ENABLED=
# OTLP/HTTP endpoint of the local collector (see otel/README.md)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Max bytes per span attribute value (default 8192). Full tool stdout and
# conversation messages are embedded in span attributes; the cap keeps
# exported traces small. Standard OTEL_SPAN_ATTRIBUTE_VALUE_LENGTH_LIMIT
# wins when set.
SLEPA_OTEL_ATTR_LIMIT=
# Experiment (id or name) that receives agent traces: the run engine
# looks traces up there to tag runs with mlflow_trace_id; the collector
# routes to it via otel/.env
MLFLOW_TELEMETRY_EXPERIMENT_ID=
# Experiment name for 'otel/check_trace.py --backend mlflow'
SLEPA_TRACE_EXPERIMENT=
# Note: SLEPA_BATCH_ID / SLEPA_PRESET / SLEPA_GIT_SHA / SLEPA_AGENT_VERSION
# are set by the CLI automatically for each dev run (root-span attributes);
# no user action needed. SLEPA_TASK_SLUG is set per task by the run engine.

# --- Agent knobs (v6-rewrite, dev-only; never set in the submission) ---
# Plan phase cap (seconds; default 30 — the regime constant in budget.py)
SHLEPA_PLAN_TIME=
# Review relay cap (seconds; default 45 — the regime constant in budget.py)
SHLEPA_REVIEW_TIME=
# Hard plan/work cycle count (default 2; the relay runs between cycles only)
SHLEPA_MAX_CYCLES=
# LAST_TOOLS tail size for the plan-timeout hand-off (default 6; 0 disables)
SHLEPA_LAST_TOOLS_N=
# Search tool on/off (default on; 0 disables)
SHLEPA_SEARCH=
# Code-search tools on/off (default on; 0 disables)
# SHLEPA_CODE_SEARCH=
# Code-search engine: "sifs" (default, bundled BM25-offline binary) or
# "rg" (ripgrep fixed-string scan)
# SHLEPA_CODE_SEARCH_ENGINE=
# Log-triage tool on/off (default on; 0 disables)
# SHLEPA_LOG_TRIAGE=

# --- Named toolset arms (dev only; the AGENT_* legacy exception) ---
# AGENT_TOOLSET: one named arm per run ("baseline", "+smart-grep", "+sifs",
# "+forensics", "+mitre-kb", "+recon", ...; see agent/shlepa_agent/toolsets.py).
# On the packaged baseline config the arm mutations append to the legacy
# per-phase tool lists, which the [tool_policy] section overrides — arms
# are a dev/A-B labelling mechanism, not a baseline switch.
# AGENT_TOOLSET=
# Legacy code-search engine switch (rg | sifs); superseded by AGENT_TOOLSET
# when that is set.
# AGENT_CODE_SEARCH=
