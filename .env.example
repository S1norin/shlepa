# Shlepa environment configuration.
# Copy to .env and fill in real values. .env is gitignored.

# --- Main LLM endpoint (experiments / dev runs) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
LOCAL_AGENT_MODEL=

# --- Secondary (weaker) endpoint for CI ---
CI_OPENAI_BASE_URL=
CI_OPENAI_API_KEY=
CI_MODEL=

# --- MLflow tracking ---
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Telemetry (dev only; always stripped from the submission zip) ---
# 1 enables OpenTelemetry span export, empty/0 disables it
SLEPA_OTEL_ENABLED=
# OTLP/HTTP endpoint of the local collector (see otel/README.md)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Experiment (id or name) that receives agent traces: the run engine
# looks traces up there to tag runs with mlflow_trace_id; the collector
# routes to it via otel/.env
MLFLOW_TELEMETRY_EXPERIMENT_ID=
# Experiment name for 'otel/check_trace.py --backend mlflow'
SLEPA_TRACE_EXPERIMENT=
# Note: SLEPA_BATCH_ID / SLEPA_PRESET / SLEPA_GIT_SHA / SLEPA_AGENT_VERSION
# are set by the CLI automatically for each dev run (root-span attributes);
# no user action needed. SLEPA_TASK_SLUG is set per task by the run engine.

# --- Agent knobs (v6, dev-only; never set in the submission) ---
# Plan phase cap (seconds; default 30 — the regime constant in budget.py)
SHLEPA_PLAN_TIME=
# Plan-failure routing: work (v6 default, every failed plan enters WORK) or
# commit (v5 routing, A0 baseline arm)
SHLEPA_ROUTE_PLAN_TIMEOUT=
# Plan-timeout hand-off: partial (v6 default, typed PartialHandoff +
# LAST_TOOLS in the work prompt) or off (v5 final_ask message, A1 arm)
SHLEPA_HANDOFF=
# LAST_TOOLS tail size for the plan-timeout hand-off (default 6; 0 disables)
SHLEPA_LAST_TOOLS_N=
# Search tool on/off (default on; 0 disables)
SHLEPA_SEARCH=
